# pve-console-log: VM serial console logs (QEMU) and CT console logs (liblxc).
# Both writers keep the file open in append mode, so copytruncate is safe.
/var/log/pve-console-*.log {
    weekly
    maxsize 20M
    rotate 8
    missingok
    notifempty
    compress
    delaycompress
    copytruncate
}
